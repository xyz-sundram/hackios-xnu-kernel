# Explicit Phone (1) service bring-up profile; runtime opt-in remains separate.
# Preserve installed UFS bounds and live touch/USB while adding reviewed drivers.
#include spacewar-storage.config
CONFIG_HAKIOS_ADSP=y
CONFIG_HAKIOS_SPEAKER=y
CONFIG_HAKIOS_HAPTIC=y
CONFIG_HAKIOS_QMI=y
CONFIG_HAKIOS_WIFI=y
CONFIG_HAKIOS_BATTERY=y
CONFIG_HAKIOS_PMIC=y
# Nothing uses NXP amplifier probes; the legacy sound playback route stays off.
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
