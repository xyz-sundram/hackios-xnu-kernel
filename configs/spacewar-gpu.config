# Layer over the Spacewar configuration. The GPU firmware and Mesa/GL libraries
# must also be present in the small root image; see docs/spacewar-gpu.md.
# For touch_live, also use the matched GPU/touch loader and prescribed touch
# arguments in docs/spacewar-gpu-touch.md.
CONFIG_HAKIOS_ADRENO=y
CONFIG_GPU=y
CONFIG_ADRENO_SPEED=1
