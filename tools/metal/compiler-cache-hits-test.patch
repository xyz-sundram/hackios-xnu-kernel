+// Exercise the actual cache/compile locking protocol without Mesa: a cache hit
+// must finish before an unrelated cold compilation is allowed to finish.
+TEST(a_compiled_stage_cache_hit_does_not_wait_for_another_compilation) {
+    std::mutex compilerLock, cacheLock;
+    std::promise<void> compiling, finishCompilation;
+    auto entered = compiling.get_future();
+    auto release = finishCompilation.get_future();
+    std::unique_ptr<int> cold;
+    std::thread worker([&] {
+        cold = detail::compileWithStageCache(compilerLock, cacheLock,
+            [] { return std::unique_ptr<int>{}; },
+            [&] {
+                compiling.set_value();
+                release.wait();
+                return std::make_unique<int>(1);
+            }, [](const int&) {});
+    });
+    entered.wait();
+    std::promise<std::unique_ptr<int>> hit;
+    auto cached = hit.get_future();
+    unsigned unwantedCompiles = 0, unwantedSaves = 0;
+    std::thread reader([&] {
+        hit.set_value(detail::compileWithStageCache(compilerLock, cacheLock,
+            [] { return std::make_unique<int>(2); },
+            [&] { ++unwantedCompiles; return std::make_unique<int>(3); },
+            [&](const int&) { ++unwantedSaves; }));
+    });
+    const bool finishedWhileCompiling = cached.wait_for(std::chrono::seconds(3)) == std::future_status::ready;
+    // Release the worker even on failure, so the old lock order fails the test
+    // instead of leaving the test runner deadlocked.
+    finishCompilation.set_value();
+    worker.join();
+    reader.join();
+    auto stage = cached.get();
+    CHECK(finishedWhileCompiling);
+    CHECK(stage != nullptr && *stage == 2);
+    CHECK(cold != nullptr && *cold == 1);
+    CHECK_EQ(unwantedCompiles, 0u);
+    CHECK_EQ(unwantedSaves, 0u);
+}
+
+TEST(concurrent_compiled_stage_cache_misses_recheck_before_compiling) {
+    std::mutex compilerLock, cacheLock, observedLock;
+    std::condition_variable observed;
+    std::unique_lock<std::mutex> holdCompiler(compilerLock);
+    unsigned misses = 0, compiles = 0, saves = 0;
+    bool present = false;
+    std::unique_ptr<int> first, second;
+    auto load = [&] {
+        if (present) return std::make_unique<int>(7);
+        {
+            std::lock_guard<std::mutex> guard(observedLock);
+            ++misses;
+        }
+        observed.notify_one();
+        return std::unique_ptr<int>{};
+    };
+    auto compile = [&] { ++compiles; return std::make_unique<int>(7); };
+    auto save = [&](const int&) { ++saves; present = true; };
+    std::thread a([&] { first = detail::compileWithStageCache(compilerLock, cacheLock, load, compile, save); });
+    std::thread b([&] { second = detail::compileWithStageCache(compilerLock, cacheLock, load, compile, save); });
+    bool bothMissed;
+    {
+        std::unique_lock<std::mutex> guard(observedLock);
+        bothMissed = observed.wait_for(guard, std::chrono::seconds(3), [&] { return misses >= 2; });
+    }
+    holdCompiler.unlock();
+    a.join();
+    b.join();
+    CHECK(bothMissed);
+    CHECK(first != nullptr && second != nullptr && *first == 7 && *second == 7);
+    CHECK_EQ(compiles, 1u);
+    CHECK_EQ(saves, 1u);
+}
