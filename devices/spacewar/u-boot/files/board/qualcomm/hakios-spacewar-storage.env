# RAM-only storage survey: initialize UFS and report devices, then serve USB.
# No block writes, persistent environment, GPT edits or slot changes.
bootdelay=0
stdin=nulldev
stdout=vidconsole
stderr=vidconsole
preboot=echo Phone (1) read-only storage survey; scsi scan; scsi info
bootcmd=fastboot -l $fastboot_addr_r usb 0
