/* Phone (1) RAM-test menu: no storage writes or slot changes. */
bootdelay=0
bootretry=1
stdin=button-kbd
stdout=vidconsole
stderr=vidconsole
hakios_status=0
fastboot=fastboot -l $fastboot_addr_r usb 0
preboot=echo "Phone (1) RAM boot menu"
bootcmd=if hakios load; then echo "HakiOS Phone (1)"; fi; bootmenu -1; run menucmd
menucmd=setenv bootcmd run menucmd; bootmenu -1
hakios_fastboot=setenv bootretry -1; run fastboot; hakios boot; run menucmd
serial_gadget=setenv stdin button-kbd,usbacm; setenv stdout vidconsole,usbacm; setenv stderr vidconsole,usbacm; setenv bootretry -1
bootmenu_0=Android (restart, RAM test)=reset
bootmenu_1=U-Boot USB fastboot=run fastboot
bootmenu_2=HakiOS (RAM payload)=hakios boot; pause
bootmenu_3=HakiOS over USB=run hakios_fastboot
bootmenu_4=Memory and partitions=hakios info; scsi info; part list scsi 0; pause
bootmenu_5=USB console=run serial_gadget
bootmenu_6=U-Boot shell=setenv bootretry -1
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
