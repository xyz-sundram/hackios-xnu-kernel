/* Installed Phone (1) menu. The build requires a private identity file.
 * Reaching this menu proves the boot-manager path; the selected HakiOS kernel
 * may still fail, and Android remains available through ABL's own slot fallback.
 */
bootdelay=0
bootretry=1
stdin=button-kbd
stdout=vidconsole
stderr=vidconsole
hakios_status=0
fastboot=fastboot -l $fastboot_addr_r usb 0
preboot=scsi scan; spacewar slot successful
bootcmd=if hakios load; then bootmenu -1; else echo HakiOS payload missing; run fastboot; fi; run menucmd
menucmd=setenv bootcmd run menucmd; bootmenu -1
boot_android=if spacewar slot unbootable; then reset; else echo Android handoff refused; pause; fi
bootmenu_0=Android=run boot_android
bootmenu_1=HakiOS=hakios boot; pause
bootmenu_2=USB fastboot=run fastboot
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
