# Start an embedded USB-only loader directly, before using U-Boot's USB gadget.
# On a load/EFI failure, serve U-Boot fastboot so its console can be inspected.
bootdelay=0
stdin=nulldev
stdout=vidconsole
stderr=vidconsole
hakios_status=0
hakios_usb_debug=0
preboot=echo Phone (1) RAM-only loader handoff diagnostic
bootcmd=if hakios load; then hakios boot; fi; fastboot -l $fastboot_addr_r usb 0
