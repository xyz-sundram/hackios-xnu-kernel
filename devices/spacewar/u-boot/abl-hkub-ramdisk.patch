Subject: [PATCH] hakios: locate a validated HKUB within ABL's initrd

Android boot header v3 can hand over vendor ramdisks before the generic
HKUB ramdisk. Search only the implicit ABL initrd, validate all table bounds
and entry CRCs without copying anything, and reject multiple valid HKUBs.
Decode headers with memcpy so a vendor prefix need not preserve alignment.
Explicit address and fastboot loads retain their existing selection behavior.
Reject implicit initrds over 256 MiB before scanning (Phone (1) currently
reports about 23 MiB of vendor ramdisks, plus our bounded HKUB payload).

Android specifies vendor ramdisks immediately followed by the generic ramdisk:
https://source.android.com/docs/core/architecture/partitions/vendor-boot-partitions

Apply after copying the common cmd/hakios.c overlay (not against upstream
U-Boot HEAD, which does not contain that file).

diff --git a/cmd/hakios.c b/cmd/hakios.c
--- a/cmd/hakios.c
+++ b/cmd/hakios.c
@@ -29,6 +29,7 @@
 #include <fdtdec.h>
 #include <init.h>
 #include <lmb.h>
+#include <limits.h>
 #include <mapmem.h>
 #include <u-boot/crc.h>
 #include <asm/cache.h>
@@ -43,6 +44,7 @@
 #define XNUP_MAGIC		0x50554E58		/* "XNUP" */
 #define HKUB_MAGIC		0x42554B48		/* "HKUB" */
 #define HKUB_VERSION		1
+#define ABL_RAMDISK_MAX		SZ_256M
 
 struct hkub_header {
 	u32 magic;
@@ -82,10 +84,12 @@
 	hi = fdtdec_get_uint64(fdt, node, "linux,initrd-end", 0);
 	if (!hi)
 		hi = fdtdec_get_uint(fdt, node, "linux,initrd-end", 0);
-	if (!lo || hi <= lo) {
+	if (!lo || hi <= lo || lo > ULONG_MAX || hi > ULONG_MAX) {
 		printf("[oosexgang] hakios: the boot image has no ramdisk\n");
 		return -ENOENT;
 	}
+	if (hi - lo > ABL_RAMDISK_MAX)
+		return -E2BIG;
 	*start = lo;
 	*size = hi - lo;
 	return 0;
@@ -120,11 +124,19 @@
  */
 static int take_loader_from_payload(const u8 *data, ulong size)
 {
-	ulong off = 8, end = 8 + ((const u32 *)data)[1];
-
