diff --git a/drivers/phy/qcom/phy-qcom-qmp-ufs.c b/drivers/phy/qcom/phy-qcom-qmp-ufs.c
--- a/drivers/phy/qcom/phy-qcom-qmp-ufs.c
+++ b/drivers/phy/qcom/phy-qcom-qmp-ufs.c
@@ -1478,6 +1478,9 @@
 
 	status = pcs + cfg->regs[QPHY_PCS_READY_STATUS];
 	ret = readl_poll_timeout(status, val, (val & PCS_READY), PHY_INIT_COMPLETE_TIMEOUT);
+#ifdef HAKIOS_SPACEWAR_UFS_TRACE
+	printf("ufs-start: PHY PCS ready @%p value=%#x ret=%d\n", status, val, ret);
+#endif
 	if (ret) {
 		dev_err(phy->dev, "phy initialization timed-out\n");
 		return ret;
diff --git a/drivers/ufs/ufs-uclass.c b/drivers/ufs/ufs-uclass.c
--- a/drivers/ufs/ufs-uclass.c
+++ b/drivers/ufs/ufs-uclass.c
@@ -513,10 +513,26 @@
 			goto out;
 
 		ret = ufshcd_dme_link_startup(hba);
+#ifdef HAKIOS_SPACEWAR_UFS_TRACE
+		/* Read-only status; do not consume clear-on-read UIC error codes. */
+		printf("ufs-start: DME_LINKSTARTUP ret=%d hce=%#x hcs=%#x is=%#x\n",
+		       ret, ufshcd_readl(hba, REG_CONTROLLER_ENABLE),
+		       ufshcd_readl(hba, REG_CONTROLLER_STATUS),
+		       ufshcd_readl(hba, REG_INTERRUPT_STATUS));
+#endif
 
 		/* check if device is detected by inter-connect layer */
 		if (!ret && !ufshcd_is_device_present(hba)) {
 			dev_err(hba->dev, "%s: Device not present\n", __func__);
+#ifdef HAKIOS_SPACEWAR_UFS_TRACE
+			/* Terminal failure only: these UIC error-code reads clear them. */
+			printf("ufs-start: terminal UIC errors pa=%#x dl=%#x nl=%#x tl=%#x dme=%#x\n",
+			       ufshcd_readl(hba, REG_UIC_ERROR_CODE_PHY_ADAPTER_LAYER),
+			       ufshcd_readl(hba, REG_UIC_ERROR_CODE_DATA_LINK_LAYER),
+			       ufshcd_readl(hba, REG_UIC_ERROR_CODE_NETWORK_LAYER),
+			       ufshcd_readl(hba, REG_UIC_ERROR_CODE_TRANSPORT_LAYER),
+			       ufshcd_readl(hba, REG_UIC_ERROR_CODE_DME));
+#endif
 			ret = -ENXIO;
 			goto out;
 		}
